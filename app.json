{
  "expo": {
    "name": "Devis Express Pro",
    "slug": "devis-express-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "devispro",
    "assetBundlePatterns": ["**/*"],
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0f1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.micodnet.devisexpresspro"
    },
    "android": {
      "package": "com.micodnet.devisexpresspro",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#0a0f1a"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0f1a",
          "image": "./assets/images/og-image.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://mvp-devis.onrender.com",
      "router": {},
      "eas": {
        "projectId": "938a5003-d133-446b-a857-c186bda11b3f"
      }
    },
    "owner": "micodnet"
  }
}